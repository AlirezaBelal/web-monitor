{
  "check_interval_seconds": 300,
  "request_timeout_seconds": 10,
  "max_attempts": 3,
  "backoff_seconds": 1,
  "health_file": ".webmonitor/health.json",
  "user_agent": "WebMonitor/4.0 (+https://github.com/AlirezaBelal/web-monitor)",
  "targets": [
    {
      "name": "homepage",
      "target_url": "http://127.0.0.1:8000/",
      "css_selector": "main",
      "comparison_mode": "text",
      "notification": {
        "backend": "console",
        "title": "WebMonitor change detected",
        "message": "Selected webpage content changed."
      }
    }
  ],
  "max_response_bytes": 2000000
}
